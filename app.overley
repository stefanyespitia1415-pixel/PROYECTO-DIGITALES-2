/* app.overlay - Blue Pill (STM32F103C8 / C6T6A) */

/* RAM real del chip: 10 KB */
&sram0 {
    reg = <0x20000000 0x2800>;
};

/* UART2: PA2 (TX) y PA3 (RX) hacia el ESP32 */
&usart2 {
    pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

/* I2C1: SCL = PB6, SDA = PB7 (MPU-6050) */
&i2c1 {
    pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
    pinctrl-names = "default";
    clock-frequency = <100000>;
    status = "okay";
};

/* PWM de la bocina: TIM1 canal 1 = PA8 */
&timers1 {
    status = "okay";

    pwm1: pwm {
        status = "okay";
        st,prescaler = <71>;
        pinctrl-0 = <&tim1_ch1_pwm_out_pa8>;
        pinctrl-names = "default";
    };
};
